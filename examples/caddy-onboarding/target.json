{
  "health": {
    "service_url": "http://127.0.0.1:18771/work",
    "service_log_path": "gateway.jsonl"
  },
  "prometheus": {
    "base_url": "http://127.0.0.1:18772",
    "service": "caddy-gateway",
    "step_seconds": 5,
    "queries": {
      "error_rate": {
        "metric": "caddy_http_request_duration_seconds_count",
        "threshold": 0.1,
        "unit": "ratio"
      }
    }
  },
  "jaeger": {
    "base_url": "http://127.0.0.1:18773"
  }
}
